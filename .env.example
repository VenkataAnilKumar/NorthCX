# Copy to .env and fill in. .env is ignored by git; never commit real values.

# REQUIRED. Letters and digits only (it is placed in a connection URL).
NORTHCX_DB_PASSWORD=
# REQUIRED. The bootstrap admin key. Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NORTHCX_API_KEY=

# The model. Set a key, or NORTHCX_DEMO=1 for the offline demo model (no AI, for trying the console only).
ANTHROPIC_API_KEY=
NORTHCX_DEMO=0

# Optional
# NORTHCX_TOKEN_SECRET=                    # signs customer chat tokens; defaults to a value derived from NORTHCX_API_KEY
# NORTHCX_APPROVAL_TTL_SECONDS=86400      # expire approvals nobody decides
# NORTHCX_WEBHOOK_URL=                    # push approval results to your system (needs NORTHCX_WEBHOOK_SECRET)
# NORTHCX_WEBHOOK_SECRET=
# Email channel (inbound mail is POSTed to /v1/channels/email/inbound by your mail gateway; replies go out over SMTP)
# NORTHCX_EMAIL_FROM=support@example.com
# NORTHCX_SMTP_URL=smtp+starttls://user:password@smtp.example.com:587   # or NORTHCX_SMTP_URL_FILE
# NORTHCX_EMAIL_AGENT=support
# NORTHCX_EMAIL_FROM_NAME=
# NORTHCX_EMAIL_TRUST_AUTH_RESULTS=0      # 1 = believe the gateway's Authentication-Results dmarc=pass as proof of sender
# NORTHCX_EMAIL_MAX_REPLIES_PER_HOUR=10   # per sender address
# Model reliability
# NORTHCX_MODEL_FALLBACKS=claude-haiku-5-5   # comma-separated, tried in order when the main model keeps failing
# NORTHCX_MODEL_RETRIES=2                    # retries per model for timeouts, rate limits and 5xx
# NORTHCX_MODEL_TIMEOUT=60                   # seconds per model call; 0 = none
# NORTHCX_DAILY_TOKEN_BUDGET=                # stop model calls (hand off to people) after this many tokens per UTC day, per server
# NORTHCX_BIND=127.0.0.1                  # 0.0.0.0 to listen on every interface (put TLS in front)
# NORTHCX_BACKEND_PORT=3000
# NORTHCX_WEB_PORT=3001

# Data retention
# NORTHCX_RETENTION_DAYS=            # erase conversations idle longer than this many days
# NORTHCX_ATTACHMENT_SCAN_URL=       # optional scanning service: gets each uploaded file and answers {"clean": true|false}; a file is refused if it flags or cannot be checked
# NORTHCX_ASSIST=on-demand           # suggested replies for people who take over: off, on-demand (a button) or auto (drafted when the hand-off is created)
# NORTHCX_ASSIST_MODEL=              # model for suggestions (defaults to the agent model)
# Single sign-on for the Studio (OpenID Connect). Needs NORTHCX_API_KEY or a database.
# NORTHCX_SSO_ISSUER=                # your identity provider, e.g. https://login.example.com
# NORTHCX_SSO_CLIENT_ID=
# NORTHCX_SSO_CLIENT_SECRET=         # or NORTHCX_SSO_CLIENT_SECRET_FILE
# NORTHCX_SSO_REDIRECT_URI=          # https://<your studio>/api/northcx/auth/sso/callback (register this with the provider)
# NORTHCX_SSO_ROLE_MAP=              # group=role pairs, e.g. cx-admins=admin,cx-editors=developer,cx-readers=viewer
# NORTHCX_SSO_DEFAULT_ROLE=          # role for people in no mapped group (unset: they cannot sign in)
# NORTHCX_SSO_ROLE_CLAIM=groups      # which token claim lists the person's groups
# NORTHCX_SSO_ALLOWED_DOMAINS=       # only these email domains may sign in, e.g. example.com
# NORTHCX_SSO_SESSION_HOURS=8        # how long a sign-in lasts (at most 24)
# NORTHCX_SSO_LANDING=/sso           # path on the Studio that receives the session

# Long conversations
# NORTHCX_SUMMARIZE_AFTER_TOKENS=6000   # replace older turns with short notes above this estimated size
# NORTHCX_SUMMARY_MODEL=                # optional cheaper model for the notes

# Customer context from your own systems (either one)
# NORTHCX_CONTEXT_PROVIDER=mycompany.context:provider   # Python object with async fetch(customer_id, session_id)
# NORTHCX_CONTEXT_URL=https://crm.example.com/northcx   # or a signed endpoint; needs the secret below
# NORTHCX_CONTEXT_SECRET=
# NORTHCX_CONTEXT_TTL_SECONDS=300
# NORTHCX_CONTEXT_TIMEOUT=3

# Long-term customer memory (on by default; 0 = off)
# NORTHCX_MEMORY=1

# SMS channel (Twilio-compatible). Set the provider's incoming webhook to NORTHCX_SMS_WEBHOOK_URL.
# NORTHCX_SMS_NUMBER=+14155550100
# NORTHCX_SMS_ACCOUNT_SID=
# NORTHCX_SMS_AUTH_TOKEN=               # or NORTHCX_SMS_AUTH_TOKEN_FILE
# NORTHCX_SMS_WEBHOOK_URL=https://your-host/channels/sms/twilio
# NORTHCX_SMS_AGENT=support
# NORTHCX_SMS_MAX_REPLIES_PER_HOUR=20

# Business hours and hand-off queues (YAML)
# NORTHCX_ROUTING_FILE=/etc/northcx/routing.yaml

# Human inbox: push hand-offs to a helpdesk (either or both)
# NORTHCX_INBOX_WEBHOOK_URL=https://helpdesk.example.com/northcx
# NORTHCX_INBOX_WEBHOOK_SECRET=          # or NORTHCX_INBOX_WEBHOOK_SECRET_FILE
# NORTHCX_PUBLIC_CONSOLE_URL=https://console.example.com
# NORTHCX_CHATWOOT_URL=https://chat.example.com
# NORTHCX_CHATWOOT_ACCOUNT_ID=1
# NORTHCX_CHATWOOT_INBOX_ID=2
# NORTHCX_CHATWOOT_TOKEN=                # or NORTHCX_CHATWOOT_TOKEN_FILE

# Trace export (either or both)
# NORTHCX_LANGFUSE_URL=https://cloud.langfuse.com
# NORTHCX_LANGFUSE_PUBLIC_KEY=
# NORTHCX_LANGFUSE_SECRET_KEY=           # or NORTHCX_LANGFUSE_SECRET_KEY_FILE
# NORTHCX_OTLP_ENDPOINT=https://otel.example.com
# NORTHCX_OTLP_HEADERS=                  # name=value,name2=value2 (or NORTHCX_OTLP_HEADERS_FILE)
# NORTHCX_TRACE_EXPORT_CONTENT=masked    # none = structure only, masked = personal data hidden, full = text kept
# NORTHCX_TRACE_EXPORT_SAMPLE=1
# NORTHCX_ENVIRONMENT=production

# Environments
# NORTHCX_STRICT_PROMOTION=0            # 1 = production only accepts versions that were live in staging

# Regression
# NORTHCX_RERUN_ON_KNOWLEDGE=off          # scripted or live: re-run scenarios tagged "knowledge" after knowledge changes
# NORTHCX_RERUN_DEBOUNCE_SECONDS=60

# Skills (reusable know-how with steps) loaded from a directory of YAML files
# NORTHCX_SKILLS_DIR=/etc/northcx/skills

# Connectors: tools defined as data (see src/backend/examples/connectors). Only these hosts may be called.
# NORTHCX_CONNECTORS_DIR=/etc/northcx/connectors
# NORTHCX_CONNECTOR_HOSTS=api.shop.example.com,billing.example.com
# NORTHCX_SECRET_ORDERS_API_TOKEN=       # credentials named in connector files, looked up like any tool secret

# Extra agent templates
# NORTHCX_TEMPLATES_DIR=/etc/northcx/templates

# Insights and alerts
# NORTHCX_PRICE_PER_MILLION_TOKENS=      # blended price, to show an estimated cost
# NORTHCX_ALERTS=on
# NORTHCX_ALERT_RULES=/etc/northcx/alerts.yaml
# NORTHCX_ALERT_WEBHOOK_URL=
# NORTHCX_ALERT_WEBHOOK_SECRET=

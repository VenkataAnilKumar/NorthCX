    "POST /v1/agents/{agent_id}/chat": {
      "permission": "chat:send",
      "parameters": [
        {
          "name": "agent_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "request": {
        "required": true,
        "schema": {
          "properties": {
            "sessionId": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "message": {
              "type": "string",
              "maxLength": 8000,
              "minLength": 1
            },
            "customerId": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "channel": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{1,19}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "environment": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(dev|staging|production)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "attachments": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "maxItems": 5
            }
          },
          "type": "object",
          "required": [
            "sessionId",
            "message"
          ]
        }
      }
    },

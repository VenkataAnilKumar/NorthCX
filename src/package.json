{
  "name": "northcx-workspace",
  "version": "1.0.0-rc.1",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @northcx/studio",
    "build": "npm run build -w @northcx/studio && npm run build -w @northcx/workspace",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  }
}
